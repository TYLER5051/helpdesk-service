# Copy this file to `.env` and adjust values as needed:
#   cp .env.example .env

# Database connection string used by the `web` container.
# Defaults match the docker-compose `db` service (user `postgres`, database `helpdesk_db`).
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/helpdesk_db

# OpenRouter API key. Leave EMPTY to run in Mock mode (no external LLM calls,
# simulated 5-30s latency). Set a real key to use models.
OPENROUTER_API_KEY=
